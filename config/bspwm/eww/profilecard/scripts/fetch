#!/usr/bin/env bash
# Basado en gh0stzk/dotfiles (https://github.com/gh0stzk/dotfiles), GPL-3.0. Copyright (C) 2021-2026 gh0stzk. Modificado por Jimmy Falco (Jimmy4TK), 2026.
# https://github.com/Jimmy4TK/Workspace
 
os() {
  awk -F '"' '/PRETTY_NAME/ {print $2}' /etc/os-release | awk '{print $1}'
}

wm() {
  wm=$DESKTOP_SESSION

  ## WM/DE
  [ ! "$wm" ] &&
    # loop over all processes and check the binary name
    for i in /proc/*/comm; do
      read -r c <"$i"
      case $c in
      *bar*) ;;
      awesome | xmonad* | qtile | sway | i3 | [bfo]*box | *wm*)
        wm=${c%%-*}
        break
        ;;
      esac
    done

  echo $wm
}

shell() {
  basename $SHELL
}

"$@"
