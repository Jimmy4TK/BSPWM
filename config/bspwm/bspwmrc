# Set environment variables
export PATH="$HOME/.config/bspwm/src:$PATH"
## Fix java applications
export _JAVA_AWT_WM_NONREPARENTING=1


for monitor in $(xrandr -q | grep -w 'connected' | cut -d' ' -f1); do
    bspc monitor "$monitor" -d '1' '2' '3' '4' '5' '6' '7' '8' '9' '0'
    #bspc monitor "$monitor" -d '' '' '' '' '' ''
done


bspc config external_rules_command "${HOME}"/.config/bspwm/src/ExternalRules

bspc config window_gap                7
bspc config split_ratio               0.5
bspc config single_monocle            true
bspc config borderless_monocle        false
bspc config gapless_monocle           false

bspc config focus_follows_pointer     false
bspc config pointer_follows_focus     false
bspc config pointer_modifier          mod4
bspc config pointer_action1           move
bspc config pointer_action2           resize_corner

bspc rule -a scratch sticky=on state=floating focus=on


# Set system vars for polybar
"$HOME"/.config/bspwm/src/SetSysVars

# Load current theme
"${HOME}"/.config/bspwm/jimmy/Theme.sh

# Launch sxhkd daemon
pidof -q sxhkd || { sxhkd -c "${HOME}"/.config/bspwm/sxhkdrc & }

# Launch picom
pidof -q picom || { picom --config "${HOME}"/.config/bspwm/picom.conf & }

# Launch eww daemon
pidof -q eww || { eww -c "${HOME}"/.config/bspwm/eww daemon & }

# Launch clipboard daemon
pidof -q greenclip || { greenclip daemon & }

# Launch polkit
pidof -q polkit-gnome-authentication-agent-1 || { /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 & }

# Launch Script to lockscreen
xss-lock -- "${HOME}"/.config/bspwm/src/.lock.sh &

# Fix cursor
xsetroot -cursor_name left_ptr

setxkbmap latam

# Load script battery low and pomodoro
"${HOME}"/.config/bspwm/src/battery.sh &
"${HOME}"/.config/bspwm/src/pomodoro.sh --open &

# Initial apps
OpenApps --element &
OpenApps --discord &

#bsp-layout set tall 6 -- --master-size 0.4
# End one time code
