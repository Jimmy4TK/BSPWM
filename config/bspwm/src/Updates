#!/usr/bin/env bash
# url: https://github.com/Jimmy4TK/WorkSpace

get_packages() { 
  echo "$(apt list --installed 2>/dev/null | grep -c -E 'installed|instalado')"
}

get_updates() { 
  echo "$(apt list --upgradable 2>/dev/null | grep -c -E 'actualizable|upgradable')"
}

update_system() {
    sudo apt upgrade
}

print_updates() { 
  echo "$(apt list --upgradable 2>/dev/null | grep -E 'actualizable|upgradable')" | sed 's/\/.\+//'
}

case "$1" in
    --get-updates) get_updates ;;
    --get-packages) get_packages ;;
    --print-updates) print_updates ;;
    --update-system) update_system ;;
    --help|*)echo -e "Updates [options]

Options:
	--get-updates		  Get the number of updates available.
	--get-packages		Get the number of packages.
  --print-updates   Show the packages with updates available. 
	--update-system		Update your system.\n"
esac
